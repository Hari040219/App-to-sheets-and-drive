# Google OAuth client (type: Desktop app) from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed by `npm run get-token` (one-time, run on your own computer)
GOOGLE_REFRESH_TOKEN=

# ID of the Drive folder that will hold one sub-folder per category
# (the long string at the end of the folder's URL)
DRIVE_ROOT_FOLDER_ID=

# ID of the Google Sheet used as the log
# (the long string between /d/ and /edit in the sheet's URL)
SHEET_ID=

# Tab name inside that sheet; created automatically if it doesn't exist
SHEET_TAB=Uploads

# Shared code field officers type in. Leave empty to disable the check.
APP_ACCESS_CODE=
